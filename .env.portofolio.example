# Tempel/ubah baris-baris ini di .env Laravel kamu.
APP_NAME="Portofolio API"
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portofolio
DB_USERNAME=root
DB_PASSWORD=

# Origin fe-portofolio (pisahkan dengan koma kalau lebih dari satu)
FRONTEND_URL=http://localhost:5173
